[
  {
    "id": "hero",
    "nome": "Hero",
    "enabled": true,
    "html": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500&display=swap\" rel=\"stylesheet\">\n<style>\n#main-content{--ink:#14110f;--ivory:#f7f3ec;--line:#e2d9ca;--warm:#f1eadf;--muted:#6b6258;--y:#b08d57;--gd:#8a6a3a;--deep:#503629;--d:'Cormorant Garamond','Times New Roman',serif;--b:'Jost','Helvetica Neue',Arial,sans-serif;--ease:cubic-bezier(.16,1,.3,1)}\n#main-content ::selection{background:#b08d57;color:#14110f}\n.ex-btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:.9rem 1.8rem;font-family:var(--b);font-weight:500;font-size:.74rem;letter-spacing:.2em;text-transform:uppercase;border-radius:0;text-decoration:none;border:1px solid transparent;transition:background-color .25s var(--ease),border-color .25s var(--ease),color .25s var(--ease)}\n.ex-btn:focus-visible{outline:2px solid var(--y);outline-offset:3px}\na.ex-btn-y,a.ex-btn-y:visited{background:var(--ivory);color:var(--ink)}a.ex-btn-y:hover{background:var(--y);color:var(--ink)}\na.ex-btn-o,a.ex-btn-o:visited{border-color:rgba(247,243,236,.45);color:var(--ivory)}a.ex-btn-o:hover{border-color:var(--ivory);color:var(--ivory)}\na.ex-btn-k,a.ex-btn-k:visited{background:#503629;color:var(--ivory)}a.ex-btn-k:hover{background:var(--y);color:var(--ink)}\n.ex-hero{position:relative;background:radial-gradient(120% 100% at 85% 0%,#6b4a3a 0%,#503629 60%);color:var(--ivory);box-sizing:border-box;display:flex;align-items:center;min-height:min(86vh,800px);min-height:min(86svh,800px);padding:clamp(3rem,8vh,6rem) 1.5rem;border-bottom:1px solid rgba(176,141,87,.35)}\n.ex-hero-in{width:100%;max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1.3fr 1fr;gap:clamp(2rem,6vw,5rem);align-items:center}\n.ex-hero .ex-eyebrow{display:flex;align-items:center;gap:1rem;margin:0 0 1.75rem;max-width:none;font-family:var(--b);font-weight:500;font-size:.72rem;letter-spacing:.34em;text-transform:uppercase;line-height:1.4;color:var(--y)}\n.ex-hero .ex-eyebrow::before{content:\"\";flex:0 0 2.75rem;height:1px;background:var(--y)}\n.ex-hero h1{font-family:var(--d);font-weight:400;font-size:clamp(2.9rem,6.2vw,5.4rem);line-height:1.02;letter-spacing:-.01em;color:var(--ivory);margin:0 0 1.75rem;max-width:13ch;text-wrap:balance}\n.ex-hero p{font-family:var(--b);font-weight:300;font-size:1.08rem;line-height:1.75;color:#cfc3ae;max-width:44ch;margin:0 0 2.5rem}\n.ex-actions{display:flex;gap:1rem;flex-wrap:wrap}\n.ex-fig{margin:0;display:block}\n.ex-stats{display:flex;flex-direction:column;gap:2rem;padding:0;margin:0;list-style:none}\n.ex-stats li{border-top:1px solid rgba(176,141,87,.5);padding-top:1rem;margin:0}\n.ex-num{display:block;font-family:var(--d);font-weight:400;font-size:clamp(2.4rem,4vw,3.4rem);line-height:1;color:var(--y);font-variant-numeric:lining-nums tabular-nums}\n.ex-lab{display:block;font-family:var(--b);font-size:.74rem;letter-spacing:.18em;text-transform:uppercase;line-height:1.6;color:#b9ad98;margin-top:.6rem}\n.ex-sec{padding:clamp(4rem,9vw,7rem) 1.5rem;background:#fbf8f3}\n.ex-sec-warm{background:var(--warm)}\n.ex-wrap{max-width:1180px;margin:0 auto}\n.ex-h2{font-family:var(--d);font-weight:500;font-size:clamp(2.1rem,3.8vw,3.3rem);line-height:1.08;letter-spacing:-.005em;color:var(--ink);margin:0;text-wrap:balance}\n.ex-2col{display:grid;grid-template-columns:1fr 1.3fr;gap:clamp(2rem,5vw,5rem);align-items:start}\n.ex-lead{font-family:var(--b);font-weight:300;font-size:1.08rem;line-height:1.75;color:var(--muted);max-width:38ch;margin:1.5rem 0 0}\n.ex-pts{list-style:none;margin:0;padding:0}\n.ex-pts li{padding:1.5rem 0;border-top:1px solid var(--line);margin:0}.ex-pts li:last-child{border-bottom:1px solid var(--line)}\n.ex-pts b{display:block;font-family:var(--d);font-weight:500;font-size:1.55rem;line-height:1.2;color:var(--ink);margin-bottom:.35rem}\n.ex-pts span{font-family:var(--b);font-weight:300;font-size:1rem;line-height:1.7;color:var(--muted)}\n.ex-grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:3rem 2.5rem;margin-top:3.5rem}\n.ex-grid3>div{border-top:1px solid var(--y);padding-top:1.25rem}\n.ex-grid3 h3{font-family:var(--d);font-size:1.55rem;font-weight:500;color:var(--ink);margin:0 0 .5rem;line-height:1.2}\n.ex-grid3 p{margin:0;font-family:var(--b);font-weight:300;font-size:1rem;line-height:1.7;color:var(--muted)}\n.ex-svc-head{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;flex-wrap:wrap;padding-bottom:1.5rem;border-bottom:1px solid var(--ink)}\n.ex-wrap>.ex-svc-head:first-child{border-bottom:0;padding-bottom:0}\n.ex-wrap>.ex-svc-head:first-child+.ex-svc-head{margin-top:2.5rem}\n.ex-svcs+.ex-svc-head{margin-top:clamp(3.5rem,7vw,5.5rem)}\n.ex-svc-head h3.ex-h2{font-size:clamp(1.8rem,3vw,2.5rem)}\n.ex-svc-head p{margin:0;font-family:var(--b);font-weight:300;color:var(--muted);max-width:36ch;font-size:1rem;line-height:1.6}\n.ex-svc-head h3 a,.ex-svc-head h3 a:visited{color:var(--ink);text-decoration:none}.ex-svc-head h3 a:hover{color:var(--gd)}\n.ex-svcs{display:grid;grid-template-columns:repeat(2,1fr);column-gap:4rem}\n.ex-svc{display:grid;grid-template-columns:1fr auto;gap:.3rem 1rem;align-items:center;padding:1.5rem .25rem;border-bottom:1px solid var(--line);text-decoration:none;color:inherit;transition:padding .3s var(--ease),border-color .3s var(--ease)}\na.ex-svc,a.ex-svc:visited{color:inherit}\n.ex-svc:hover{padding-left:.9rem;border-bottom-color:var(--y)}\n.ex-svc:focus-visible{outline:2px solid var(--y);outline-offset:-2px}\n.ex-svc-t{font-family:var(--d);font-weight:500;font-size:1.45rem;line-height:1.2;color:var(--ink)}\n.ex-svc-d{grid-column:1;font-family:var(--b);font-weight:300;font-size:.92rem;line-height:1.55;color:var(--muted)}\n.ex-svc svg{grid-column:2;grid-row:1/span 2;width:22px;height:22px;stroke:var(--gd);fill:none;stroke-width:1.2;transition:transform .3s var(--ease)}\n.ex-svc:hover svg{transform:translateX(5px)}\n.ex-band{background:var(--warm);padding:clamp(3.5rem,7vw,5.5rem) 1.5rem;border-top:1px solid var(--line)}\n.ex-end{background:var(--deep);padding:clamp(3.5rem,7vw,5.5rem) 1.5rem}\n.ex-band-in{max-width:1180px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;gap:2rem;flex-wrap:wrap}\n.ex-band p{margin:.75rem 0 0;font-family:var(--b);font-weight:300;color:var(--muted);font-size:1.05rem;line-height:1.6}\n.ex-end .ex-h2{color:var(--ivory)}.ex-end p{margin:.75rem 0 0;font-family:var(--b);font-weight:300;color:#cfc3ae;font-size:1.05rem;line-height:1.6}\n@media (max-width:820px){.ex-hero-in,.ex-2col{grid-template-columns:1fr}.ex-stats{flex-direction:row;flex-wrap:wrap;gap:1.5rem 2rem}.ex-stats li{flex:1 1 9rem}.ex-grid3{grid-template-columns:1fr 1fr}.ex-svcs{grid-template-columns:1fr}}\n@media (max-width:560px){.ex-grid3{grid-template-columns:1fr}.ex-sec,.ex-hero,.ex-band,.ex-end{padding-left:1.25rem;padding-right:1.25rem}.ex-btn{width:100%}}\n@media (prefers-reduced-motion:reduce){.ex-btn,.ex-svc,.ex-svc svg{transition:none}}\n</style>\n<header class=\"ex-hero\" aria-label=\"Hero\"><div class=\"ex-hero-in\"><div><p class=\"ex-eyebrow\">Energia rinnovabile · Casa e aziende</p><h1>Produci la tua energia dal sole.</h1><p>Fotovoltaico, batterie di accumulo, pompe di calore e ricarica per auto elettriche: dal progetto all'assistenza.</p><div class=\"ex-actions\"><a class=\"ex-btn ex-btn-y\" href=\"__BASEURL__/contatti/\">Chiedi un preventivo</a><a class=\"ex-btn ex-btn-o\" href=\"#categorie\">Guarda i servizi</a></div></div><figure class=\"ex-fig\" style=\"grid-template-columns:1fr\"><ul class=\"ex-stats\"><li><span class=\"ex-num\">3</span><span class=\"ex-lab\">aree: casa, aziende e assistenza</span></li><li><span class=\"ex-num\">15</span><span class=\"ex-lab\">tipi di impianto e servizio</span></li></ul></figure></div></header>"
  },
  {
    "id": "whatis",
    "nome": "Passi (spento)",
    "enabled": false,
    "html": "<section class=\"ex-sec\" id=\"whatis\" aria-labelledby=\"whatis-title\"><div class=\"ex-wrap ex-2col\"><div><h2 class=\"ex-h2\" id=\"whatis-title\">Come funziona</h2><p class=\"ex-lead\">Dal primo contatto all'impianto acceso, in tre passi.</p></div><ol class=\"ex-pts\"><li><b>Chiedi un preventivo</b><span>Scrivici dalla pagina Contatti e raccontaci cosa ti serve.</span></li><li><b>Sopralluogo e progetto</b><span>Valutiamo tetto e consumi e prepariamo il progetto.</span></li><li><b>Installazione e pratiche</b><span>Installiamo l'impianto e ti aiutiamo con le pratiche.</span></li></ol></div></section>"
  },
  {
    "id": "stack",
    "nome": "Perché Heliora Energia",
    "enabled": true,
    "html": "<section class=\"ex-sec ex-sec-warm\" id=\"stack\" aria-labelledby=\"stack-title\"><div class=\"ex-wrap\"><h2 class=\"ex-h2\" id=\"stack-title\">Perché Heliora Energia</h2><div class=\"ex-grid3\"><div><h3>Un impianto su misura</h3><p>Lo dimensioniamo in base ai tuoi consumi e al tuo tetto.</p></div><div><h3>Preventivo chiaro</h3><p>Prima di iniziare sai cosa è incluso e quanto costa.</p></div><div><h3>Assistenza dopo l'installazione</h3><p>Controlli, monitoraggio e pulizia, quando servono.</p></div></div></div></section>"
  },
  {
    "id": "features",
    "nome": "Categorie",
    "enabled": true,
    "html": "<section class=\"ex-sec\" id=\"categorie\" aria-labelledby=\"features-title\"><div class=\"ex-wrap\"><div class=\"ex-svc-head\"><h2 class=\"ex-h2\" id=\"features-title\">Categorie</h2><p>Scegli l'area e poi il servizio che ti interessa.</p></div><div class=\"ex-svc-head\"><h3 class=\"ex-h2\"><a href=\"__BASEURL__/negozio/categoria/casa/\">Per la casa</a></h3><p>Impianti per villette, appartamenti e condomini.</p></div><div class=\"ex-svcs\"><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/casa-fotovoltaico/\"><span class=\"ex-svc-t\">Fotovoltaico residenziale</span><span class=\"ex-svc-d\">Impianti fotovoltaici su tetto per produrre la tua energia.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/casa-accumulo/\"><span class=\"ex-svc-t\">Batterie di accumulo</span><span class=\"ex-svc-d\">Batterie per usare la sera l'energia prodotta di giorno.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/casa-pompe/\"><span class=\"ex-svc-t\">Pompe di calore</span><span class=\"ex-svc-d\">Riscaldamento, raffrescamento e acqua calda con una sola macchina.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/casa-solare-termico/\"><span class=\"ex-svc-t\">Solare termico</span><span class=\"ex-svc-d\">Pannelli per scaldare l'acqua con il sole.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/casa-colonnine/\"><span class=\"ex-svc-t\">Colonnine di ricarica</span><span class=\"ex-svc-d\">Wallbox per ricaricare l'auto elettrica a casa.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/casa-condomini/\"><span class=\"ex-svc-t\">Condomini e comunità energetiche</span><span class=\"ex-svc-d\">Impianti condominiali e comunità energetiche per condividere l'energia.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a></div><div class=\"ex-svc-head\"><h3 class=\"ex-h2\"><a href=\"__BASEURL__/negozio/categoria/aziende/\">Per le aziende</a></h3><p>Impianti per capannoni, negozi, uffici e aziende agricole.</p></div><div class=\"ex-svcs\"><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/az-fotovoltaico/\"><span class=\"ex-svc-t\">Fotovoltaico industriale</span><span class=\"ex-svc-d\">Impianti su capannoni, tetti e parcheggi per ridurre i costi.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/az-agricolo/\"><span class=\"ex-svc-t\">Aziende agricole</span><span class=\"ex-svc-d\">Impianti per stalle, serre, cantine e coperture agricole.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/az-accumulo/\"><span class=\"ex-svc-t\">Accumulo e autoconsumo</span><span class=\"ex-svc-d\">Sistemi di accumulo per usare in azienda l'energia che produci.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/az-ricarica/\"><span class=\"ex-svc-t\">Ricarica per flotte e parcheggi</span><span class=\"ex-svc-d\">Colonnine per auto aziendali, clienti e dipendenti.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/az-diagnosi/\"><span class=\"ex-svc-t\">Diagnosi energetica</span><span class=\"ex-svc-d\">Analisi dei consumi per capire dove risparmiare.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a></div><div class=\"ex-svc-head\"><h3 class=\"ex-h2\"><a href=\"__BASEURL__/negozio/categoria/assistenza/\">Assistenza</a></h3><p>Controlli, pulizia e pratiche per il tuo impianto.</p></div><div class=\"ex-svcs\"><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/as-manutenzione/\"><span class=\"ex-svc-t\">Manutenzione impianti</span><span class=\"ex-svc-d\">Controlli periodici e interventi su impianti già installati.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/as-monitoraggio/\"><span class=\"ex-svc-t\">Monitoraggio della produzione</span><span class=\"ex-svc-d\">Controllo di quanta energia produce e consuma il tuo impianto.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/as-pulizia/\"><span class=\"ex-svc-t\">Pulizia dei pannelli</span><span class=\"ex-svc-d\">Pulizia dei pannelli per mantenere la resa.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/as-pratiche/\"><span class=\"ex-svc-t\">Pratiche e incentivi</span><span class=\"ex-svc-d\">Aiuto con le pratiche e con gli incentivi disponibili.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a></div></div></section>"
  },
  {
    "id": "pricing",
    "nome": "Chiedi un preventivo",
    "enabled": true,
    "html": "<section class=\"ex-band\" id=\"pricing\" aria-labelledby=\"pricing-title\"><div class=\"ex-band-in\"><div><h2 class=\"ex-h2\" id=\"pricing-title\">Chiedi un preventivo</h2><p>Raccontaci la tua casa o la tua azienda e ti rispondiamo in italiano.</p></div><a class=\"ex-btn ex-btn-k\" href=\"__BASEURL__/contatti/\">Chiedi un preventivo</a></div></section>"
  },
  {
    "id": "cta",
    "nome": "CTA finale",
    "enabled": false,
    "html": "<section class=\"ex-end\" aria-labelledby=\"cta-title\"><div class=\"ex-band-in\"><div><h2 class=\"ex-h2\" id=\"cta-title\">Hai un progetto particolare?</h2><p>Scrivici: ti diciamo se possiamo realizzarlo.</p></div><a class=\"ex-btn ex-btn-y\" href=\"__BASEURL__/contatti/\">Contattaci</a></div></section>"
  }
]
