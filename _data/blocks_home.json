[
  {
    "id": "hero",
    "nome": "Hero",
    "enabled": true,
    "html": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500&display=swap\" rel=\"stylesheet\">\n<style>\n#main-content{--ink:#14110f;--ivory:#f7f3ec;--line:#e2d9ca;--warm:#f1eadf;--muted:#6b6258;--y:#b08d57;--gd:#8a6a3a;--deep:#503629;--d:'Cormorant Garamond','Times New Roman',serif;--b:'Jost','Helvetica Neue',Arial,sans-serif;--ease:cubic-bezier(.16,1,.3,1)}\n#main-content ::selection{background:#b08d57;color:#14110f}\n.ex-btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:.9rem 1.8rem;font-family:var(--b);font-weight:500;font-size:.74rem;letter-spacing:.2em;text-transform:uppercase;border-radius:0;text-decoration:none;border:1px solid transparent;transition:background-color .25s var(--ease),border-color .25s var(--ease),color .25s var(--ease)}\n.ex-btn:focus-visible{outline:2px solid var(--y);outline-offset:3px}\na.ex-btn-y,a.ex-btn-y:visited{background:var(--ivory);color:var(--ink)}a.ex-btn-y:hover{background:var(--y);color:var(--ink)}\na.ex-btn-o,a.ex-btn-o:visited{border-color:rgba(247,243,236,.45);color:var(--ivory)}a.ex-btn-o:hover{border-color:var(--ivory);color:var(--ivory)}\na.ex-btn-k,a.ex-btn-k:visited{background:#503629;color:var(--ivory)}a.ex-btn-k:hover{background:var(--y);color:var(--ink)}\n.ex-hero{position:relative;background:radial-gradient(120% 100% at 85% 0%,#6b4a3a 0%,#503629 60%);color:var(--ivory);box-sizing:border-box;display:flex;align-items:center;min-height:min(86vh,800px);min-height:min(86svh,800px);padding:clamp(3rem,8vh,6rem) 1.5rem;border-bottom:1px solid rgba(176,141,87,.35)}\n.ex-hero-in{width:100%;max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1.3fr 1fr;gap:clamp(2rem,6vw,5rem);align-items:center}\n.ex-hero .ex-eyebrow{display:flex;align-items:center;gap:1rem;margin:0 0 1.75rem;max-width:none;font-family:var(--b);font-weight:500;font-size:.72rem;letter-spacing:.34em;text-transform:uppercase;line-height:1.4;color:var(--y)}\n.ex-hero .ex-eyebrow::before{content:\"\";flex:0 0 2.75rem;height:1px;background:var(--y)}\n.ex-hero h1{font-family:var(--d);font-weight:400;font-size:clamp(2.9rem,6.2vw,5.4rem);line-height:1.02;letter-spacing:-.01em;color:var(--ivory);margin:0 0 1.75rem;max-width:13ch;text-wrap:balance}\n.ex-hero p{font-family:var(--b);font-weight:300;font-size:1.08rem;line-height:1.75;color:#cfc3ae;max-width:44ch;margin:0 0 2.5rem}\n.ex-actions{display:flex;gap:1rem;flex-wrap:wrap}\n.ex-fig{margin:0;display:block}\n.ex-stats{display:flex;flex-direction:column;gap:2rem;padding:0;margin:0;list-style:none}\n.ex-stats li{border-top:1px solid rgba(176,141,87,.5);padding-top:1rem;margin:0}\n.ex-num{display:block;font-family:var(--d);font-weight:400;font-size:clamp(2.4rem,4vw,3.4rem);line-height:1;color:var(--y);font-variant-numeric:lining-nums tabular-nums}\n.ex-lab{display:block;font-family:var(--b);font-size:.74rem;letter-spacing:.18em;text-transform:uppercase;line-height:1.6;color:#b9ad98;margin-top:.6rem}\n.ex-sec{padding:clamp(4rem,9vw,7rem) 1.5rem;background:#fbf8f3}\n.ex-sec-warm{background:var(--warm)}\n.ex-wrap{max-width:1180px;margin:0 auto}\n.ex-h2{font-family:var(--d);font-weight:500;font-size:clamp(2.1rem,3.8vw,3.3rem);line-height:1.08;letter-spacing:-.005em;color:var(--ink);margin:0;text-wrap:balance}\n.ex-2col{display:grid;grid-template-columns:1fr 1.3fr;gap:clamp(2rem,5vw,5rem);align-items:start}\n.ex-lead{font-family:var(--b);font-weight:300;font-size:1.08rem;line-height:1.75;color:var(--muted);max-width:38ch;margin:1.5rem 0 0}\n.ex-pts{list-style:none;margin:0;padding:0}\n.ex-pts li{padding:1.5rem 0;border-top:1px solid var(--line);margin:0}.ex-pts li:last-child{border-bottom:1px solid var(--line)}\n.ex-pts b{display:block;font-family:var(--d);font-weight:500;font-size:1.55rem;line-height:1.2;color:var(--ink);margin-bottom:.35rem}\n.ex-pts span{font-family:var(--b);font-weight:300;font-size:1rem;line-height:1.7;color:var(--muted)}\n.ex-grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:3rem 2.5rem;margin-top:3.5rem}\n.ex-grid3>div{border-top:1px solid var(--y);padding-top:1.25rem}\n.ex-grid3 h3{font-family:var(--d);font-size:1.55rem;font-weight:500;color:var(--ink);margin:0 0 .5rem;line-height:1.2}\n.ex-grid3 p{margin:0;font-family:var(--b);font-weight:300;font-size:1rem;line-height:1.7;color:var(--muted)}\n.ex-svc-head{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;flex-wrap:wrap;padding-bottom:1.5rem;border-bottom:1px solid var(--ink)}\n.ex-wrap>.ex-svc-head:first-child{border-bottom:0;padding-bottom:0}\n.ex-wrap>.ex-svc-head:first-child+.ex-svc-head{margin-top:2.5rem}\n.ex-svcs+.ex-svc-head{margin-top:clamp(3.5rem,7vw,5.5rem)}\n.ex-svc-head h3.ex-h2{font-size:clamp(1.8rem,3vw,2.5rem)}\n.ex-svc-head p{margin:0;font-family:var(--b);font-weight:300;color:var(--muted);max-width:36ch;font-size:1rem;line-height:1.6}\n.ex-svc-head h3 a,.ex-svc-head h3 a:visited{color:var(--ink);text-decoration:none}.ex-svc-head h3 a:hover{color:var(--gd)}\n.ex-svcs{display:grid;grid-template-columns:repeat(2,1fr);column-gap:4rem}\n.ex-svc{display:grid;grid-template-columns:1fr auto;gap:.3rem 1rem;align-items:center;padding:1.5rem .25rem;border-bottom:1px solid var(--line);text-decoration:none;color:inherit;transition:padding .3s var(--ease),border-color .3s var(--ease)}\na.ex-svc,a.ex-svc:visited{color:inherit}\n.ex-svc:hover{padding-left:.9rem;border-bottom-color:var(--y)}\n.ex-svc:focus-visible{outline:2px solid var(--y);outline-offset:-2px}\n.ex-svc-t{font-family:var(--d);font-weight:500;font-size:1.45rem;line-height:1.2;color:var(--ink)}\n.ex-svc-d{grid-column:1;font-family:var(--b);font-weight:300;font-size:.92rem;line-height:1.55;color:var(--muted)}\n.ex-svc svg{grid-column:2;grid-row:1/span 2;width:22px;height:22px;stroke:var(--gd);fill:none;stroke-width:1.2;transition:transform .3s var(--ease)}\n.ex-svc:hover svg{transform:translateX(5px)}\n.ex-band{background:var(--warm);padding:clamp(3.5rem,7vw,5.5rem) 1.5rem;border-top:1px solid var(--line)}\n.ex-end{background:var(--deep);padding:clamp(3.5rem,7vw,5.5rem) 1.5rem}\n.ex-band-in{max-width:1180px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;gap:2rem;flex-wrap:wrap}\n.ex-band p{margin:.75rem 0 0;font-family:var(--b);font-weight:300;color:var(--muted);font-size:1.05rem;line-height:1.6}\n.ex-end .ex-h2{color:var(--ivory)}.ex-end p{margin:.75rem 0 0;font-family:var(--b);font-weight:300;color:#cfc3ae;font-size:1.05rem;line-height:1.6}\n@media (max-width:820px){.ex-hero-in,.ex-2col{grid-template-columns:1fr}.ex-stats{flex-direction:row;flex-wrap:wrap;gap:1.5rem 2rem}.ex-stats li{flex:1 1 9rem}.ex-grid3{grid-template-columns:1fr 1fr}.ex-svcs{grid-template-columns:1fr}}\n@media (max-width:560px){.ex-grid3{grid-template-columns:1fr}.ex-sec,.ex-hero,.ex-band,.ex-end{padding-left:1.25rem;padding-right:1.25rem}.ex-btn{width:100%}}\n@media (prefers-reduced-motion:reduce){.ex-btn,.ex-svc,.ex-svc svg{transition:none}}\n</style>\n<header class=\"ex-hero\" aria-label=\"Hero\"><div class=\"ex-hero-in\"><div><p class=\"ex-eyebrow\">Pelletteria · Donna e Uomo</p><h1>Pelle e cuoio fatti per durare, per lei e per lui.</h1><p>Borse, zaini, valigeria, portafogli, cinture, giacche e scarpe in pelle: scegli Donna o Uomo.</p><div class=\"ex-actions\"><a class=\"ex-btn ex-btn-y\" href=\"__BASEURL__/negozio/categoria/donna/\">Donna</a><a class=\"ex-btn ex-btn-y\" href=\"__BASEURL__/negozio/categoria/uomo/\">Uomo</a><a class=\"ex-btn ex-btn-o\" href=\"#categorie\">Guarda le categorie</a></div></div><figure class=\"ex-fig\" style=\"grid-template-columns:1fr\"><ul class=\"ex-stats\"><li><span class=\"ex-num\">2</span><span class=\"ex-lab\">reparti: Donna e Uomo</span></li><li><span class=\"ex-num\">21</span><span class=\"ex-lab\">sottocategorie di articoli in pelle</span></li></ul></figure></div></header>"
  },
  {
    "id": "whatis",
    "nome": "Passi (spento)",
    "enabled": false,
    "html": "<section class=\"ex-sec\" id=\"whatis\" aria-labelledby=\"whatis-title\"><div class=\"ex-wrap ex-2col\"><div><h2 class=\"ex-h2\" id=\"whatis-title\">Come si pre-ordina</h2><p class=\"ex-lead\">Scegli l'articolo, indica la quantità e invia la richiesta: nessun pagamento anticipato.</p></div><ol class=\"ex-pts\"><li><b>Scegli il reparto</b><span>Donna o Uomo, poi la categoria che ti serve.</span></li><li><b>Aggiungi al carrello</b><span>Il prezzo è scritto accanto a ogni articolo.</span></li><li><b>Invia la richiesta</b><span>Non paghi niente in questo momento.</span></li><li><b>Ti scriviamo noi</b><span>Ti contattiamo appena l'articolo è pronto.</span></li></ol></div></section>"
  },
  {
    "id": "stack",
    "nome": "Perch? Pelletteria",
    "enabled": true,
    "html": "<section class=\"ex-sec ex-sec-warm\" id=\"stack\" aria-labelledby=\"stack-title\"><div class=\"ex-wrap\"><h2 class=\"ex-h2\" id=\"stack-title\">Perch? Pelletteria</h2><div class=\"ex-grid3\"><div><h3>Due reparti, tutto in ordine</h3><p>Donna e Uomo, con le categorie sotto ciascuno.</p></div><div><h3>Prezzi chiari</h3><p>Il prezzo ? scritto accanto a ogni articolo.</p></div><div><h3>Supporto in italiano</h3><p>Scrivici dalla pagina Contatti.</p></div></div></div></section>"
  },
  {
    "id": "features",
    "nome": "Categorie",
    "enabled": true,
    "html": "<section class=\"ex-sec\" id=\"categorie\" aria-labelledby=\"features-title\"><div class=\"ex-wrap\"><div class=\"ex-svc-head\"><h2 class=\"ex-h2\" id=\"features-title\">Categorie</h2><p>Scegli il reparto e poi la categoria che ti serve.</p></div><div class=\"ex-svc-head\"><h3 class=\"ex-h2\"><a href=\"__BASEURL__/negozio/categoria/donna/\">Donna</a></h3><p>Borse, portafogli, cinture, giacche, scarpe e accessori in pelle da donna.</p></div><div class=\"ex-svcs\"><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/donna-borse-mano/\"><span class=\"ex-svc-t\">Borse a mano</span><span class=\"ex-svc-d\">Borse a mano strutturate, bauletti e secchiello in pelle.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/donna-borse-spalla/\"><span class=\"ex-svc-t\">Borse a spalla</span><span class=\"ex-svc-d\">Borse a spalla e hobo bag in pelle, comode ogni giorno.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/donna-tracolle/\"><span class=\"ex-svc-t\">Tracolle e mini bag</span><span class=\"ex-svc-d\">Tracolle, mini bag e marsupi in pelle.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/donna-shopper/\"><span class=\"ex-svc-t\">Shopper e tote</span><span class=\"ex-svc-d\">Shopper capienti e tote bag per lavoro e tempo libero.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/donna-pochette/\"><span class=\"ex-svc-t\">Pochette e clutch</span><span class=\"ex-svc-d\">Pochette, clutch e borse da sera in pelle.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/donna-zaini/\"><span class=\"ex-svc-t\">Zaini</span><span class=\"ex-svc-d\">Zaini in pelle da città e da lavoro.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/donna-portafogli/\"><span class=\"ex-svc-t\">Portafogli e portacarte</span><span class=\"ex-svc-d\">Portafogli, portacarte, portamonete e portachiavi.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/donna-viaggio/\"><span class=\"ex-svc-t\">Valigeria e viaggio</span><span class=\"ex-svc-d\">Trolley, borsoni da viaggio, beauty case e weekender.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/donna-cinture/\"><span class=\"ex-svc-t\">Cinture</span><span class=\"ex-svc-d\">Cinture in cuoio e pelle, classiche e sottili.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/donna-giacche/\"><span class=\"ex-svc-t\">Giacche e capispalla</span><span class=\"ex-svc-d\">Giacche, giubbotti, gilet e cappotti in pelle.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/donna-scarpe/\"><span class=\"ex-svc-t\">Scarpe e stivali</span><span class=\"ex-svc-d\">Scarpe, stivali e ballerine in pelle.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/donna-accessori/\"><span class=\"ex-svc-t\">Guanti e accessori</span><span class=\"ex-svc-d\">Guanti, sciarpe, cappelli e cinturini in pelle.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a></div><div class=\"ex-svc-head\"><h3 class=\"ex-h2\"><a href=\"__BASEURL__/negozio/categoria/uomo/\">Uomo</a></h3><p>Borse da lavoro, zaini, portafogli, cinture, giacche e scarpe in pelle da uomo.</p></div><div class=\"ex-svcs\"><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/uomo-24ore/\"><span class=\"ex-svc-t\">Borse 24 ore e porta PC</span><span class=\"ex-svc-d\">Cartelle, borse 24 ore e porta PC in pelle per il lavoro.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/uomo-messenger/\"><span class=\"ex-svc-t\">Messenger e tracolle</span><span class=\"ex-svc-d\">Messenger, tracolle e borse a spalla da uomo.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/uomo-zaini/\"><span class=\"ex-svc-t\">Zaini</span><span class=\"ex-svc-d\">Zaini in pelle da città, da lavoro e da viaggio.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/uomo-viaggio/\"><span class=\"ex-svc-t\">Valigeria e borsoni</span><span class=\"ex-svc-d\">Trolley, borsoni da viaggio, weekender e portabiti.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/uomo-portafogli/\"><span class=\"ex-svc-t\">Portafogli e portacarte</span><span class=\"ex-svc-d\">Portafogli, portacarte, porta passaporto e portachiavi.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/uomo-cinture/\"><span class=\"ex-svc-t\">Cinture e bretelle</span><span class=\"ex-svc-d\">Cinture in cuoio e pelle, con fibbie classiche.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/uomo-giacche/\"><span class=\"ex-svc-t\">Giacche e giubbotti</span><span class=\"ex-svc-d\">Giacche, giubbotti e gilet in pelle.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/uomo-scarpe/\"><span class=\"ex-svc-t\">Scarpe e stivali</span><span class=\"ex-svc-d\">Scarpe stringate, mocassini e stivali in pelle.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/uomo-accessori/\"><span class=\"ex-svc-t\">Guanti e accessori</span><span class=\"ex-svc-d\">Guanti, cappelli, sciarpe e cinturini per orologio.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a></div></div></section>"
  },
